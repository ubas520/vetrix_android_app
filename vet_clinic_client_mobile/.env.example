# Public API base used by the Expo bundle. Do not put passwords or tokens here.
# Keep /api/mobile/v1 at the end and omit the trailing slash.
# For a physical phone, replace the address with this computer's Wi-Fi IPv4 address.
EXPO_PUBLIC_VETRIX_API_URL=http://192.168.100.100/vetrix/api/mobile/v1

# Optional website address for scannable pet QR links; defaults to the API URL
# without /api/mobile/v1. Use a public HTTPS URL for scanning away from clinic Wi-Fi.
# Never use localhost or 10.0.2.2 here when scanning with a physical phone.
# EXPO_PUBLIC_VETRIX_WEBSITE_URL=https://your-clinic.example/vetrix
