{
  "name": "vet-clinic-client-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "node ./scripts/start-expo.js",
    "android": "node ./scripts/start-expo.js --android",
    "ios": "node ./scripts/start-expo.js --ios",
    "web": "node ./scripts/start-expo.js --web",
    "clean": "node ./scripts/clean-generated.js",
    "clean:all": "node ./scripts/clean-generated.js --include-dependencies",
    "clean:dry": "node ./scripts/clean-generated.js --dry-run",
    "lint": "expo lint",
    "check:visual": "node ./scripts/live-integration-check.js",
    "check:integration": "node ./scripts/live-integration-check.js",
    "check:orders": "node ./scripts/check-product-orders.js",
    "check:qr": "expo export --platform web --output-dir .expo-export-check/pet-qr && node scripts/check-pet-qr.js",
    "check:qr-camera": "node scripts/check-qr-camera.js",
    "check:ui": "expo export --platform web --output-dir .expo-export-check/ui-refresh && node scripts/check-ui.js"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.4.9",
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/native-stack": "^7.3.28",
    "expo": "~57.0.20",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.22",
    "lucide-react-native": "^1.31.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-qrcode-svg": "^6.3.22",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jsqr": "^1.4.0",
    "playwright-core": "^1.62.1",
    "pngjs": "^7.0.0"
  }
}
